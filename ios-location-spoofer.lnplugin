#!name=iOS Location Spoofer
#!desc=拦截 Apple 定位服务回传的坐标并置换为指定位置（Loon）

[Argument]
enabled = switch,true,tag=启用定位修改
latitude = input,"43.65738",tag=纬度
longitude = input,"122.25281",tag=经度
altitude = input,"530",tag=海拔(米)
horizontalAccuracy = input,"39",tag=水平精度
verticalAccuracy = input,"1000",tag=垂直精度
address = input,"",tag=地址搜索
configUrl = input,"https://cdn.jsdelivr.net/gh/qqo2000/Swift-iOS-location@main/Resources/location-spoofer-config.json",tag=远程配置URL
debug = switch,true,tag=调试日志

[Script]
http-request ^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/qqo2000/Swift-iOS-location@main/Resources/location-spoofer.js, requires-body=false, timeout=3, tag=iOS Location Spoofer Prepare, argument=[{debug}]
http-response ^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/qqo2000/Swift-iOS-location@main/Resources/location-spoofer.js, requires-body=true, binary-body-mode=true, max-size=1048576, timeout=12, tag=iOS Location Spoofer, argument=[{enabled},{latitude},{longitude},{altitude},{horizontalAccuracy},{verticalAccuracy},{address},{configUrl},{debug}]

[mitm]
hostname = gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com